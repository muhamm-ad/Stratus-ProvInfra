# Development environment configuration

environment  = "dev"
project_name = "stratus"
owner_email  = "134101309+muhamm-ad@users.noreply.github.com"

cloud_providers = {
  aws = {
    region       = "us-east-1"
    access_key   = "your-access-key"
    secret_key   = "your-secret-key"
    access_token = "your-access-token"
    vpc_cidr     = "10.0.0.0/16"
  }
  azure = {
    subscription_id     = "your-subscription-id"
    client_id           = "your-client-id"
    client_secret       = "your-client-secret"
    tenant_id           = "your-tenant-id"
    location            = "eastus"
    vnet_cidr           = "10.1.0.0/16"
  }
  gcp = {
    project_id   = "project-1234567890"
    region       = "us-central1"
    network_cidr = "10.2.0.0/16"

  }
}

instances = {
  linux = {
    count = 1
    instance_type = {
      aws   = "t3.micro"
      azure = "Standard_B1s"
      gcp   = "e2-micro"
    }
    cidr = {
      aws   = "10.0.1.0/24"
      azure = "10.1.1.0/24"
      gcp   = "10.2.1.0/24"
    }
    disk = {
      aws = {
        size = 40
        type = "gp3"
      }
      azure = {
        size_gb = 32
        type = "Premium_LRS"
      }
      gcp = {
        size = 40
        type = "gp3"
      }
    }
    script = "#!/bin/bash\n\n# Install Nginx\napt-get update\napt-get install -y nginx"
  }
  windows = {
    count = 1
    instance_type = {
      aws   = "t3.small"
      azure = "Standard_B2s"
      gcp   = "e2-small"
    }
    cidr = {
      aws   = "10.0.2.0/24"
      azure = "10.1.2.0/24"
      gcp   = "10.2.2.0/24"
    }
    disk = {
      aws = {
        size = 50
        type = "gp3"
      }
      azure = {
        size_gb = 50
        type = "Premium_LRS"
      }
      gcp = {
        size = 50
        type = "gp3"
      }
    }
    script = "Install-WindowsFeature -Name Web-Server -IncludeManagementTools"
  }
}

additional_tags = {
}
